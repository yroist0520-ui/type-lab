# TYPE LAB — AI 配置示例
# 复制为 .env.local（开发）或在部署环境中设置同名变量。
# 密钥只存在于服务端，前端不会拿到它。

# 任何兼容 OpenAI 协议的服务地址，例如 https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1

# 服务端密钥（不要提交到仓库，不要写进前端代码）
AI_API_KEY=

# 视觉模型：用于字体风格分析，需要支持图片输入
AI_VISION_MODEL=gpt-4o-mini

# 图像模型：用于生成单个字形图片（透明背景 PNG）
AI_IMAGE_MODEL=gpt-image-1
